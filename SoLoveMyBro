                    if not Item or not SoundPart then
                        for _,v in pairs(inv:GetChildren()) do
                            if v.Name == "AntiKickItem" then
                                pcall(function()
                                    if destroyToy then destroyToy:FireServer(v) end
                                end)
                            end
                        end
                        
                        Item = SpawnToy(selectedAntiKickToy)
                        if not Item then
                            continue
                        end
                        
                        SoundPart = Item and (Item:FindFirstChild("Hitbox") or Item:FindFirstChild("SoundPart") or Item:FindFirstChildWhichIsA("BasePart"))
