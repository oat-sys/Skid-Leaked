local function hkHandleBring(plr, rightDetector, rightWeld, creatureGrab, creatureRelease, plrHRP)
    local plrHum = plr.Character:FindFirstChild("Humanoid")
    if not (plrHum and plrHum.Health ~= 0 and hkState.Blob) then return end
    
    if hkIsGrabbed(plr.Character) then
        local target = hkState.BringTargets[plr.UserId]
        if target == "none" or target == "crip" or not target then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                if target == "crip" then
                    plrHum.WalkSpeed = 0
                end
            end
            hkState.BringTargets[plr.UserId] = nil
        else
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = target
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
            hkState.BringTargets[plr.UserId] = nil
            if hkState.KickTargets[plr.UserId] or (hkState.KickAll and (hkState.KickFriendWL and not LocalPlayer:IsFriendsWith(plr.UserId) or not hkState.KickFriendWL)) then
                hkState.Action = "Kick"
            end
        end
    else
        creatureGrab:FireServer(rightDetector, plrHRP, rightWeld)
        creatureRelease:FireServer(rightWeld, plrHRP)
    end
end

local function hkHandleKick(plr, rightDetector, rightWeld, creatureGrab, creatureDrop)
    if plr.Character.Parent == workspace then
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(hrp, hrp.CFrame)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 1E10, 0)
            ReplicatedStorage.GrabEvents.DestroyGrabLine:FireServer(hrp)
            local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            creatureGrab:FireServer(rightDetector, hrp, rightWeld)
            if myHRP then
                creatureGrab:FireServer(rightDetector, myHRP, rightWeld)
            end
            creatureDrop:FireServer(rightWeld, hrp)
        end
    else
        hkState.BringTargets[plr.UserId] = CFrame.new(-73, -6, -265.5)
    end
end

local function hkHandleKill(plr, rightDetector, rightWeld, creatureGrab, creatureRelease)
    local plrHum = plr.Character:FindFirstChild("Humanoid")
    if not (plrHum and plrHum.Health ~= 0 and hkState.Blob) then return end
    if hkState.BringTargets[plr.UserId] == "bris" then
        hkState.BringTargets[plr.UserId] = nil
    end
    plrHum:ChangeState(Enum.HumanoidStateType.Dead)
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        creatureGrab:FireServer(rightDetector, hrp, rightWeld)
        creatureRelease:FireServer(rightWeld, hrp)
    end
end

local function hkSpawnBlob()
    local toysFolder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if toysFolder then
        for _, itm in pairs(toysFolder:GetChildren()) do
            if itm.Name == "CreatureBlobman" and itm:FindFirstChild("VehicleSeat") then
                local rd = itm:FindFirstChild("RightDetector")
                local rw = rd and rd:FindFirstChild("RightWeld")
                if rd and rw then
                    hkState.FoundBlob = true
                    hkState.Blob = itm
                    return true
                else
                    hkDestroyBlob(itm)
                end
            elseif itm.Name == "CreatureBlobman" then
                hkDestroyBlob(itm)
                task.wait(0.1)
            end
        end
    end
    return false
end

function hkBlobService()
    while true do
        local hkListMode = (hkState.KickAll or hkState.KillAll) and 2 or 1
        hkState.BlobRunning = false

        for _, plr in pairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            
            local plrId = plr.UserId
            
            -- Handle Bring Targets
            if hkState.BringTargets[plrId] and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and hkIsGrabbed(plr.Character) then
                local target = hkState.BringTargets[plrId]
                if target == "none" or target == "crip" or not target or target == "bris" then
                    if target == "crip" then
                        local hum = plr.Character:FindFirstChild("Humanoid")
                        if hum then hum.WalkSpeed = 0 end
                    end
                    hkState.BringTargets[plrId] = nil
                else
                    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = target
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end
                    hkState.BringTargets[plrId] = nil
                    if hkState.KickTargets[plrId] or (hkState.KickAll and (hkState.KickFriendWL and not LocalPlayer:IsFriendsWith(plrId) or not hkState.KickFriendWL)) then
                        hkState.Action = "Kick"
                    end
                end
                continue
            end
            
            -- Check if player needs action
            local needsAction = hkState.KickTargets[plrId] or hkState.KillTargets[plrId] or hkState.BringTargets[plrId] or hkState.KickAll or hkState.KillAll
            if not needsAction then continue end
            
            local savedCF, savedVel
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                savedCF = LocalPlayer.Character.HumanoidRootPart.CFrame
                savedVel = LocalPlayer.Character.HumanoidRootPart.AssemblyLinearVelocity
            end
            
            local action = nil
            if hkState.BringTargets[plrId] and hkState.BringTargets[plrId] ~= "bris" then
                action = "Bring"
            elseif hkState.KillTargets[plrId] or hkState.BringTargets[plrId] == "bris" then
                action = "Kill"
            elseif hkState.KickTargets[plrId] then
                action = "Kick"
            else
                if hkState.KickAll and (not hkState.KickFriendWL or not hkState.FriendIds[plrId]) then
                    action = "Kick"
                end
                if hkState.KillAll and (not hkState.KillFriendWL or not hkState.FriendIds[plrId]) then
                    action = "Kill"
                end
            end
            
            if not action then continue end
            
            local continueFlag = false
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                if plr.Character.HumanoidRootPart.Massless then
                    if plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.SeatPart then
                        continueFlag = true
                    end
                else
                    continueFlag = true
                end
            end
            
            if not continueFlag then continue end
            
            local isActive = true
            while isActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid:GetState() ~= Enum.HumanoidStateType.Dead and continueFlag do
                
                if hkListMode == 2 then
                    if not hkState.KickAll and not hkState.KillAll then
                        isActive = false
                    elseif hkState.FriendIds[plrId] then
                        isActive = false
                    end
                else
                    if not hkState.KickTargets[plrId] and not hkState.KillTargets[plrId] and not hkState.BringTargets[plrId] then
                        isActive = false
                    end
                end
                
                hkState.BlobRunning = true
                continueFlag = true
                
                -- Main blob logic
                if isActive and continueFlag and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid:GetState() ~= Enum.HumanoidStateType.Dead and LocalPlayer.Character.Humanoid.SeatPart and LocalPlayer.Character.Humanoid.SeatPart.Parent and LocalPlayer.Character.Humanoid.SeatPart.Parent.Name == "CreatureBlobman" then
                    hkState.ExpectingBlob = true
                    hkState.Blob = LocalPlayer.Character.Humanoid.SeatPart.Parent
                    
                    if hkState.Blob:FindFirstChild("HumanoidCreature") then
                        hkState.Blob.HumanoidCreature.PlatformStand = true
                    end
                    
                    local rightDetector = hkState.Blob:FindFirstChild("RightDetector")
                    local rightWeld = rightDetector and rightDetector:FindFirstChild("RightWeld")
                    local scriptObj = hkState.Blob:FindFirstChild("BlobmanSeatAndOwnerScript")
                    local creatureGrab = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
                    local creatureRelease = scriptObj and scriptObj:FindFirstChild("CreatureRelease")
                    local creatureDrop = scriptObj and scriptObj:FindFirstChild("CreatureDrop")
                    
                    if rightDetector and rightWeld and creatureGrab and creatureRelease and creatureDrop then
                        local plrHRP = plr.Character:FindFirstChild("HumanoidRootPart")
                        if plrHRP then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = (plrHRP.CFrame * CFrame.new(0, -20, 10)) + (plrHRP.AssemblyLinearVelocity / math.pi)
                            LocalPlayer.Character.HumanoidRootPart.AssemblyLinearVelocity = plrHRP.AssemblyLinearVelocity
                            
                            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                                if action == "Bring" then
                                    hkHandleBring(plr, rightDetector, rightWeld, creatureGrab, creatureRelease, plrHRP)
                                elseif action == "Kick" then
                                    hkHandleKick(plr, rightDetector, rightWeld, creatureGrab, creatureDrop)
                                elseif action == "Kill" then
                                    hkHandleKill(plr, rightDetector, rightWeld, creatureGrab, creatureRelease)
                                end
                            end
                        end
                    else
                        local toysFolder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                        if toysFolder then
                            local blob = toysFolder:FindFirstChild("CreatureBlobman")
                            if blob then hkDestroyBlob(blob) end
                        end
                    end
                elseif continueFlag then
                    hkState.ExpectingBlob = true
                    hkState.FoundBlob = false
                    
                    local playerHum = LocalPlayer.Character:FindFirstChild("Humanoid")
                    if playerHum and playerHum.SeatPart and (not playerHum.SeatPart.Parent or playerHum.SeatPart.Parent.Name ~= "CreatureBlobman") then
                        playerHum.Sit = false
                    end
                    
                    if hkState.Blob and hkState.Blob:FindFirstChild("VehicleSeat") then
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
                            hkState.Blob.VehicleSeat:Sit(LocalPlayer.Character.Humanoid)
                        end
                    else
                        hkState.Blob = nil
                        hkSpawnBlob()
                        
                        if hkState.Blob and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
                            hkState.Blob.VehicleSeat:Sit(LocalPlayer.Character.Humanoid)
                        end
                        
                        if not hkState.FoundBlob then
                            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                if LocalPlayer.Character.Parent ~= workspace then
                                    hrp.CFrame = CFrame.new(0, -10, 0)
                                    hrp.AssemblyLinearVelocity = Vector3.zero
                                end
                                
                                while isActive and not hkState.Blob do
                                    if hkListMode == 2 then
                                        if not hkState.KickAll and not hkState.KillAll then
                                            isActive = false
                                        elseif hkState.FriendIds[plrId] then
                                            isActive = false
                                        end
                                    else
                                        if not (hkState.KickTargets[plrId] or hkState.KillTargets[plrId] or hkState.BringTargets[plrId]) then
                                            isActive = false
                                        end
                                    end
                                    
                                    hkSpawnBlob()
                                    
                                    if not hkState.Blob then
                                        task.spawn(function()
                                            pcall(function()
                                                ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(
                                                    "CreatureBlobman",
                                                    CFrame.new(LocalPlayer.Character.HumanoidRootPart.CFrame.Position) + Vector3.new(0, 0, 15),
                                                    Vector3.zero
                                                )
                                            end)
                                        end)
                                    end
                                    task.wait()
                                end
                            end
                        end
                    end
                end
                task.wait()
            end
            
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = savedCF
                LocalPlayer.Character.HumanoidRootPart.AssemblyLinearVelocity = savedVel
            end
        end
        
        if not hkState.BlobRunning and hkState.Blob then
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.SeatPart and LocalPlayer.Character.Humanoid.SeatPart.Parent == hkState.Blob then
                LocalPlayer.Character.Humanoid.Sit = false
            end
            task.wait()
            if hkState.Blob and hkState.Blob:FindFirstChild("HumanoidRootPart") then
                hkState.Blob.HumanoidRootPart.CFrame = CFrame.new(0, 1e15, 0)
            end
        end
        
        hkState.ExpectingBlob = false
        task.wait()
    end
end

