KickSection:AddToggle({
    Name = "Pallet Ragdoll",
    Default = false,
    Callback = function(Value)
        local RS = game:GetService("ReplicatedStorage")
        local RunService = game:GetService("RunService")
        local DestroyToy = RS:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
        local SetNetOwner = RS:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
        local DestroyLine = RS:WaitForChild("GrabEvents"):WaitForChild("DestroyGrabLine")
        local toysFolder = workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys")
        local lpName = LocalPlayer.Name
        
        local palletRagdollActive = false
        local PalletForRagdoll = nil
        local palletCacheConn = nil
        local ragdollSteppedConn = nil
        local clearAttackLoop = nil
        
        clearAttackLoop = function()
            if ragdollSteppedConn then
                ragdollSteppedConn:Disconnect()
                ragdollSteppedConn = nil
            end
        end
        
        local function spawnNewPallet()
            if not palletRagdollActive then return end
            if PalletForRagdoll and PalletForRagdoll.Parent then return end
            
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if not h then return end

            task.spawn(function()
                pcall(function()
                    RS.MenuToys.SpawnToyRemoteFunction:InvokeServer(
                        "PalletLightBrown",
                        h.CFrame * CFrame.new(0, 10, 20),
                        Vector3.zero
                    )
                end)
            end)
        end

        if Value then
            if not SelectedTarget or SelectedTarget == "No players found" then
                return
            end

            palletRagdollActive = true
            PalletForRagdoll = nil
            
            if palletCacheConn then
                palletCacheConn:Disconnect()
                palletCacheConn = nil
            end
            clearAttackLoop()

            palletCacheConn = toysFolder.ChildAdded:Connect(function(child)
                if not palletRagdollActive then return end
                if child.Name ~= "PalletLightBrown" and child.Name ~= "PalletForRagdoll" then return end

                local soundPart = child:WaitForChild("SoundPart", 3)
                if not soundPart then return end

                pcall(function()
                    SetNetOwner:FireServer(soundPart, soundPart.CFrame)
                    DestroyLine:FireServer(soundPart)
                end)

                local partOwner = soundPart:WaitForChild("PartOwner", 1)
                if partOwner and partOwner.Value == lpName then
                    for _, v in pairs(child:GetChildren()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                            v.CanQuery = false
                            v.Transparency = 1 
                        end
                    end

                    child.Name = "PalletForRagdoll"
                    PalletForRagdoll = child

                    local strikePhase = false

                    ragdollSteppedConn = RunService.Stepped:Connect(function()
                        if not palletRagdollActive or not child.Parent then 
                            clearAttackLoop()
                            return 
                        end

                        local currentTarget = GetPlayerByName(SelectedTarget)
                        if not currentTarget then
                            clearAttackLoop()
                            return
                        end

                        local tChar = currentTarget and currentTarget.Character
                        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

                        if tRoot and tHum and soundPart.Parent and tHum.Health > 0 then
                            local ragdolledVal = tHum:FindFirstChild("Ragdolled")
                            local isRagdolled = ragdolledVal and ragdolledVal.Value or false

                            if not isRagdolled then
                                strikePhase = not strikePhase
                                if strikePhase then
                                    soundPart.CFrame = tRoot.CFrame * CFrame.new(0, 2, 0)
                                    soundPart.AssemblyLinearVelocity = Vector3.new(0, -9e5, 0)
                                else
                                    soundPart.CFrame = tRoot.CFrame * CFrame.new(0, -1, 0)
                                    soundPart.AssemblyLinearVelocity = Vector3.new(0, 9e5, 0)
                                end
                            else
                                soundPart.CFrame = CFrame.new(0, 9e9, 0)
                                soundPart.AssemblyLinearVelocity = Vector3.zero
                            end
                        else
                            soundPart.CFrame = CFrame.new(0, 9e9, 0)
                            soundPart.AssemblyLinearVelocity = Vector3.zero
                        end
                    end)

                    child.AncestryChanged:Connect(function()
                        if not child.Parent then
                            clearAttackLoop()
                            PalletForRagdoll = nil
                            if palletRagdollActive then
                                task.wait(0.03)
                                spawnNewPallet()
                            end
                        end
                    end)
                else
                    pcall(function() DestroyToy:FireServer(child) end)
                end
            end)

            spawnNewPallet()
        else
            palletRagdollActive = false
            clearAttackLoop()

            if palletCacheConn then
                palletCacheConn:Disconnect()
                palletCacheConn = nil
            end

            local pallet = PalletForRagdoll
            if pallet and pallet.Parent then
                pcall(function() DestroyToy:FireServer(pallet) end)
            end

            PalletForRagdoll = nil

            if toysFolder:FindFirstChild("PalletForRagdoll") then
                pcall(function() DestroyToy:FireServer(toysFolder.PalletForRagdoll) end)
            end
        end
    end
})

