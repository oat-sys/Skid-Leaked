-- Server Lag Line พร้อม Slider ปรับความแรง 1-11
local lagLineActive = false
local lagLineTask = nil
local lagLineLevel = 1

local function ServerLagLineFunction(level)
    local players = game:GetService("Players")
    local rs = game:GetService("ReplicatedStorage")
    local createGrabLineEvent = rs:WaitForChild("GrabEvents"):WaitForChild("CreateGrabLine")
    
    local intensity = level * 2
    local waitTime = 0.5 - ((level - 1) * 0.045)
    waitTime = math.max(waitTime, 0.05)
    
    while lagLineActive do
        for _ = 1, intensity do
            for _, player in pairs(players:GetPlayers()) do
                if player.Character then
                    local torso = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
                    if torso then
                        pcall(function()
                            createGrabLineEvent:FireServer(torso, torso.CFrame)
                        end)
                    end
                end
            end
        end
        task.wait(waitTime)
    end
end

